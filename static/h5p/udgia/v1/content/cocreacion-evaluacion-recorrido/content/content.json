            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {"text": "<h2>4. Evalúa proceso, producto y transferencia</h2><p><strong>Estudiante:</strong> explica qué cambió y qué aprendió.<br><strong>Docente:</strong> combina calidad del producto con evidencias del proceso.<br><strong>Coordinación:</strong> acuerda mínimos comunes sin imponer vigilancia exhaustiva.</p>"},
